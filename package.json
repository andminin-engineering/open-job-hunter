{
  "name": "open-job-hunter",
  "version": "1.1.0",
  "description": "An open-source MCP server that discovers and AI-evaluates job offers against YOUR configurable profile — 100% local, private, and self-hosted.",
  "type": "module",
  "main": "desktop/main.cjs",
  "bin": {
    "open-job-hunter": "build/bin/mcp.js"
  },
  "scripts": {
    "dev": "tsx src/bin/http.ts",
    "dev:watch": "tsx watch src/bin/http.ts",
    "build": "tsc",
    "start": "npm run build && node build/bin/http.js",
    "start:mcp": "node build/bin/mcp.js",
    "start:all": "node build/bin/all.js",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "test": "vitest run --passWithNoTests",
    "test:runtime": "npm run build && node scripts/verify-runtime.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "job-search",
    "job-hunter",
    "ollama",
    "llm",
    "ai-agent",
    "career",
    "self-hosted"
  ],
  "author": "Andrea Minín",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andminin-engineering/open-job-hunter.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "nodemailer": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.andminin.openjobhunter",
    "productName": "Open Job Hunter",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "build/**/*",
      "app/**/*",
      "config/profile.example.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Open-Job-Hunter-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Open-Job-Hunter-Portable-${version}-${arch}.${ext}"
    }
  }
}
