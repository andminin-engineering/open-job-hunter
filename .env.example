# open-job-hunter — environment configuration
# Copy this file to .env and fill in your own values. NEVER commit .env.

# --- Candidate profile ---
# Optional: override the default config/profile.json location.
# PROFILE_PATH=./config/profile.json

# Optional defaults used by the email / application-pack helpers.
APPLICANT_NAME=Your Name
PORTFOLIO_URL=https://github.com/your-handle

# --- Local LLM (Ollama) ---
# open-job-hunter evaluates offers with a LOCAL model — your data never leaves your machine.
OLLAMA_BASE_URL=http://localhost:11434

# --- HTTP bridge ---
PORT=3000

# --- Scheduler (optional: periodic discovery + email digest) ---
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires
SCHEDULER_EMAIL_TO=your-email@example.com

# --- SMTP (optional: only needed if you want email digests) ---
# For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
